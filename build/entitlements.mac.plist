<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ad-hoc (unsigned) builds. V8 needs allow-jit under the hardened runtime. An ad-hoc signature
  has no Team ID, so library validation would reject Electron's own frameworks; this build
  therefore disables it. No sandbox, network, camera, microphone or other device entitlements.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
